# =============================================================================
# RECIFE: MUSEU A CÉU ABERTO - CONFIGURAÇÃO DE AMBIENTE (.env.example)
# =============================================================================

# Porta e Host do servidor Node.js
PORT=4173
HOST=127.0.0.1

# Token de Acesso Seguro para o Painel da Curadoria / Desenvolvedor
# Recomendado: Gerar token criptográfico seguro com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVELOPER_ACCESS_TOKEN=substitua_por_um_token_criptografico_seguro_64_caracteres

# URL da Planilha de Dados do Google Sheets (modo exportação CSV / GViz)
# GOOGLE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/SEU_ID_AQUI/export?format=csv
