{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-app-server",
      "type": "npm",
      "script": "serve",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": { "regexp": "^(.*)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Recife MCA disponível em http://"
        }
      }
    }
  ]
}
